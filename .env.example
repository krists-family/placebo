# Self-hosted Next.js storefront. The hosted review uses COMMERCE_MODE=preview.
COMMERCE_MODE=medusa
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_URL=http://localhost:9000/app
MEDUSA_PUBLISHABLE_KEY=copy-the-publishable-key-from-medusa-admin
STRIPE_PUBLIC_KEY=
LIVE_PAYMENTS_ENABLED=false
LEGAL_DETAILS_READY=false
ALLOW_TEST_ORDERS=true
# Used only by the owner-private hosted review. Disable before making it public.
PRIVATE_ADMIN_ENABLED=false
ADMIN_USER_IDS=
